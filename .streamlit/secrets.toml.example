# Copy to .streamlit/secrets.toml (local, never committed) or paste into
# Streamlit Cloud > App settings > Secrets. Use your own long random value.

# Required once, to create the first administrator on a fresh deployment.
FORENCHAIN_SETUP_TOKEN = "replace-with-a-long-random-value"

# Optional: where the MVSS-Net checkpoint is downloaded from (default: GitHub Release model-v1).
# FORENCHAIN_MODEL_URL = "https://github.com/<owner>/<repo>/releases/download/model-v1/mvssnet_casia.pt"
